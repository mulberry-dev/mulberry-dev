# EmailJS — same setup as Fuente de Vida Residencial (browser SDK, no backend).
# https://dashboard.emailjs.com
#
# 1. Email Services → Gmail connected to mulberry.developer@gmail.com
# 2. Email Templates → one template with:
#    To Email: {{to_email}}
#    From Name: {{from_name}}
#    Reply To: {{reply_to}}
#    Subject: {{subject}}
#    Content (HTML): {{{html_body}}}
#    Content (Text): {{text_body}}
# 3. Account → API Keys → copy the Public Key (it is NOT the service_… id)
# 4. Optional: a second template for the visitor confirmation:
#    NEXT_PUBLIC_EMAILJS_REPLY_TEMPLATE_ID=template_xxxx
#
NEXT_PUBLIC_EMAILJS_SERVICE_ID=service_2tovkmi
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=template_77n4e2o
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
NEXT_PUBLIC_EMAILJS_REPLY_TEMPLATE_ID=
